{
    "name": "@gottheflag/shortcut",
    "version": "0.1.0-beta.2",
    "description": "A professional keyboard shortcut manager for web applications.",
    "type": "module",
    "license": "Apache-2.0",
    "author": {
        "name": "GTF",
